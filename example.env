# ── Server ────────────────────────────────────────────────
PORT=4001
NODE_ENV=development

# ── PostgreSQL ────────────────────────────────────────────
PGHOST=localhost
PGPORT=5432
PGDATABASE=soda_store
PGUSER=postgres
PGPASSWORD=postgres

# ── Auth (JWT) ────────────────────────────────────────────
# Use a long, random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=1d

# ── CORS ──────────────────────────────────────────────────
# Comma-separated list of allowed origins (the frontend URL)
CORS_ORIGIN=http://localhost:3000
