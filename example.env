# Full connection string (takes precedence over individual DB_* / PG* variables).
# Use this format: ******host:port/database
DATABASE_URL=

DB_USER=your_postgres_username
DB_HOST=localhost
DB_NAME=soda_soft_drink_store
DB_PASSWORD=your_password
DB_PORT=5432

# Legacy aliases still supported by config.js
PGUSER=your_postgres_username
PGHOST=localhost
PGDATABASE=soda_soft_drink_store
PGPASSWORD=your_password
PGPORT=5432

PORT=3000
JWT_SECRET=your_secure_jwt_secret_key
